{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: Policy Search (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": [
        "--dart-define=POLICY_SEARCH_BASE_URL=https://your-api-endpoint.com/search"
      ]
    },
    {
      "name": "Flutter: Policy Search (Profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define=POLICY_SEARCH_BASE_URL=https://your-api-endpoint.com/search"
      ]
    }
  ]
}