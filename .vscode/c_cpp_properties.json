{
  "version": 4,
  "configurations": [
    {
      "name": "Win32",
      "intelliSenseMode": "windows-msvc-x64",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "includePath": [
        "${workspaceFolder}/windows",
        "${workspaceFolder}/windows/flutter",
        "${workspaceFolder}/windows/flutter/ephemeral",
        "${workspaceFolder}/windows/flutter/ephemeral/cpp_client_wrapper/include",
        "${workspaceFolder}/windows/flutter/ephemeral/.plugin_symlinks/**",
        "${workspaceFolder}/windows/flutter/ephemeral/.plugin_symlinks/*/windows/include",
        "${workspaceFolder}/build/windows/x64/plugins/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/windows",
          "${workspaceFolder}/windows/flutter/ephemeral",
          "${workspaceFolder}/windows/flutter/ephemeral/cpp_client_wrapper/include",
          "${workspaceFolder}/windows/flutter/ephemeral/.plugin_symlinks"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
